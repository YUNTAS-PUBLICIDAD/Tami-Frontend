---
import Layout from "src/layouts/Layout.astro";
import ProductPage from "src/components/products/ProductPage";
import type Producto from "src/models/Product";
import { config } from "../../../config";

const { link } = Astro.params;

if (!link) {
  return Astro.redirect("/404");
}

//construye la URL
const apiUrl = config.apiUrl ? String(config.apiUrl).replace(/\/+$/, "") : "";
const url = `${apiUrl}${config.endpoints.productos.detail(link)}`;

const response = await fetch(url);

if (!response.ok) {
  return Astro.redirect("/404");
}

//espera y obtiene los datos 
const rawData = await response.json();


const producto: Producto = rawData.data ?? rawData;
---

<Layout
  title="Detalle de Producto - Tami Maquinarias"
  description="Cargando detalles de producto..."
  keywords=""
  canonicalUrl={`https://tamimaquinarias.com/catalogo-maquinarias/${producto.link}`}
>
  <ProductPage producto={producto} client:load />
</Layout>

<script is:inline>
  (function () {
    var canonicalLink = document.querySelector('link[rel="canonical"]');
    if (canonicalLink) {
      canonicalLink.href = window.location.href.split("#")[0];
    }
  })();
</script>